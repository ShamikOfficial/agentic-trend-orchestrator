# Single source of truth for BOTH backend + frontend.
# Backend reads this directly.
# Frontend (frontend/next.config.ts) loads ./.env or ../.env (repo root) so
# `npm run dev` in frontend/ and `npm --prefix frontend run dev` from the repo root both work.
# It sets NEXT_PUBLIC_API_BASE_URL from APP_ENV + API_BASE_URL_DEV/API_BASE_URL_PROD.

APP_ENV=development
LOG_LEVEL=info

# Shared API base selection for frontend:
# - development => API_BASE_URL_DEV
# - production  => API_BASE_URL_PROD
API_BASE_URL_DEV=http://127.0.0.1:8000/api/v1
API_BASE_URL_PROD=https://agentic-trend-orchestrator-production.up.railway.app/api/v1

# Optional override. If set, this takes priority in frontend over APP_ENV logic.
# NEXT_PUBLIC_API_BASE_URL=

# CORS: comma-separated browser origins allowed to call the API (in addition to localhost).
# Add your production frontend origin, e.g. https://my-app.vercel.app
# CORS_ORIGINS=https://my-app.vercel.app,https://www.example.com

# Allow https://*.vercel.app Origins (Vercel Preview + default *.vercel.app URLs).
# Default is on; set to false to disable (e.g. lock API to listed origins only).
# CORS_ALLOW_VERCEL=false

# Optional explicit regex instead of the built-in Vercel pattern (validated at startup).
# CORS_ORIGIN_REGEX=

# LLM (Google AI / Gemini API) — shared by Team Assistant, Chat Ask AI (@chat), and gemini_test.ipynb.
# GEMINI_API_KEY=

# Primary model id for backend (optional). If unset, GEMMA_TEST_MODEL is used, then gemma-3-27b-it.
# LLM_MODEL=

# Same variable as gemini_test.ipynb — set once to keep notebook + Team + Chat aligned:
# GEMMA_TEST_MODEL=gemma-3-27b-it

# Optional comma-separated fallbacks if the primary model errors (quota, 404, etc.):
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemma-3-12b-it

# systemInstruction support: auto (default) merges system into user text for Gemma models;
# set true to always use API system instruction, false to always merge.
# GEMINI_USE_SYSTEM_INSTRUCTION=auto

# JSON response MIME (structured JSON output): auto skips for Gemma (API rejects it); true/false to force.
# GEMINI_USE_RESPONSE_JSON_MIME=auto

# Verbose LLM logs (merge/retry messages). Raw HTTP bodies: LLM_DEBUG_RAW=1 (default off).
# LLM_VERBOSE=1
# LLM_DEBUG_RAW=1

# Auto task extraction from chat: how many new messages before auto-analyzing (default 5).
# Manual "Analyze Tasks" button bypasses this threshold.
# TASK_EXTRACT_BATCH_SIZE=5
# Force analyze: how many last messages to analyze on manual button press (default 10).
# TASK_EXTRACT_FORCE_COUNT=10

# --- Railway / production persistence ---
# DATABASE_URL=postgresql://...   # Injected by Railway Postgres plugin
# UPLOAD_ROOT=/data/uploads
# TREND_VIDEO_ROOT=/data/trend_videos
# AUTH_JWT_SECRET=               # Same value as Vercel AUTH_SECRET
# AUTH_JWT_ISSUER=https://your-app.vercel.app
# LLM_MONTHLY_TOKEN_BUDGET=200000
# LLM_MAX_REQUESTS_PER_DAY=50
# LLM_GLOBAL_DISABLED=false
# ALLOW_PASSWORD_AUTH=true
# TREND_ANALYTICS_ENABLED=false
# ADMIN_API_KEY=

# --- Auth.js (Vercel frontend) ---
# AUTH_SECRET=
# AUTH_URL=https://your-app.vercel.app
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# NEXT_PUBLIC_ALLOW_PASSWORD_AUTH=true

# Optional for future integrations:
# OPENAI_API_KEY=
