# Frontend uses root .env as the single source of truth.
# Set values in ../.env:
# - APP_ENV=development|production
# - API_BASE_URL_DEV=...
# - API_BASE_URL_PROD=...
#
# You can still override only frontend here if needed:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# MVP sidebar (default off; backend APIs unchanged)
# NEXT_PUBLIC_ENABLE_SCRIPT_GENERATION=true
# NEXT_PUBLIC_ENABLE_TREND_DETECTION=true
# NEXT_PUBLIC_ENABLE_VIDEO_UPLOAD=true

# Chat message sync interval in seconds (default 3)
# NEXT_PUBLIC_CHAT_POLL_SECONDS=3

# Auth.js (set in root .env or Vercel):
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
